#!/usr/bin/env python3
"""findings — the ledger of defects found along the way (rules/found-defects-last.md).

A finding is shown in the chat once, in the reply where it was found. The
ledger keeps it after that, so later replies do not have to repeat it and a
/compact or a new session does not lose it. bin/found-defects-guard records the
"Found along the way" section of every finished reply here; nobody types `add`
by hand in normal use.

Storage: one append-only JSONL event log, $FINDINGS_DIR/ledger.jsonl
(default $XDG_STATE_HOME/findings/, else ~/.local/state/findings/). Each
finding carries its project: the git top level of the path it points at, else
of the session's cwd, else the cwd itself. That is the routing: a finding about
another repository is listed under that repository, not under the one the
session happened to run in. It also carries the session that found it.

  findings list   [--scope session|project|all] [--session ID] [-p PATH]
                  [--status S,...]                     digest, open first
  findings count  [-p PATH]                            one line, for hooks
  findings set    STATUS ID...                          open|park|skip|done
  findings add    --where W --text T [--tag related|unrelated|urgent]...
                  [--cwd DIR] [--session ID]
  findings record --cwd DIR [--session ID] < reply     parse the section
  findings compact                                     one record per finding;
                                                       old done to the archive
  findings list --archive [--all]                      what compaction archived

IDs are global and sequential, so F7 means one finding whatever the project:
3, F3, 4-9 and 3,5 are all accepted by `set`.

`list` shows this session's findings by default — every project they were
filed under — and one line counting what else is open in the project. The
session id comes from --session, else $FINDINGS_SESSION, else
$CLAUDE_CODE_SESSION_ID (set by Claude Code for every shell it runs). Without
one, `list` shows the whole project and says so. --scope project is the whole
project, --scope all (or --all) every project.
Statuses: open (default), park (keep, stop showing), skip (declined),
done (fixed). A duplicate of an open, parked or skipped finding is not added
again; a duplicate of a done one is, because that is a regression.
"""
import argparse
import datetime
import difflib
import json
import os
import re
import shutil
import subprocess
import sys

# One writer at a time. fcntl does not exist on Windows; msvcrt.locking on the
# first byte is the equivalent there (LK_LOCK retries for ~10 s, then raises).
# Writes still go to the end: the file is opened in append mode.
try:
    import fcntl

    def lock(f):
        fcntl.flock(f, fcntl.LOCK_EX)
except ImportError:
    import msvcrt

    def lock(f):
        f.seek(0)
        msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)
import time

DIR = os.environ.get("FINDINGS_DIR") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "findings")
STATUSES = ("open", "park", "skip", "done")

SECTION = re.compile(
    r"^#{1,6}\s*(найдено попутно|найдено по ходу|попутно найдено|found along the way)\s*:?\s*$",
    re.I | re.M)
HEADING = re.compile(r"^#{1,6}\s+\S", re.M)
ITEM = re.compile(r"^\s*\d+[.)]\s+(.*\S)\s*$")
TAGS = re.compile(r"^((?:\[[^\]]+\]\s*)+)")
TAG_MAP = {
    "related": "related", "связано": "related",
    "unrelated": "unrelated", "не связано": "unrelated",
    "urgent": "urgent", "срочно": "urgent",
}
OFFER = re.compile(r"\s*(исправить|fix)\s*\?\s*$", re.I)


# ── projects ────────────────────────────────────────────────────────────────

def toplevel(path):
    path = os.path.realpath(os.path.expanduser(path))
    d = path if os.path.isdir(path) else os.path.dirname(path)
    while d and not os.path.isdir(d):
        d = os.path.dirname(d)
    if not d:
        return None
    try:
        out = subprocess.run(["git", "-C", d, "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return None


def project_of(cwd):
    return toplevel(cwd) or os.path.realpath(cwd)


def route(where, cwd):
    """The project a finding belongs to: the repository its path points at."""
    # /abs, ~/rel, or a Windows drive path C:\x or C:/x; ":" ends the path
    # (path:line), so a drive letter is matched as its own prefix.
    m = re.match(r"^(~?/[^\s:`,]+|[A-Za-z]:[\\/][^\s:`,]+)", where or "")
    if m:
        p = os.path.expanduser(m.group(1))
        if os.path.exists(p) or os.path.exists(os.path.dirname(p)):
            top = toplevel(p)
            if top:
                return top
    return project_of(cwd)


def ledger():
    return os.path.join(DIR, "ledger.jsonl")


def archive_path():
    return os.path.join(DIR, "archive.jsonl")


# `done` findings older than this leave the working ledger for archive.jsonl
# when it is compacted; compaction runs by itself once the ledger is bigger
# than FINDINGS_COMPACT_BYTES. `skip` stays: it is what keeps a declined
# finding from coming back, and the duplicate check reads only the ledger.
ARCHIVE_DAYS = float(os.environ.get("FINDINGS_ARCHIVE_DAYS", "30"))
COMPACT_BYTES = int(os.environ.get("FINDINGS_COMPACT_BYTES", str(1 << 20)))


# ── the log ─────────────────────────────────────────────────────────────────

def read(path):
    """({id: item}, the highest id ever handed out) from one log file.

    UTF-8 explicitly: Windows would otherwise use the ANSI code page and fail
    on the first Cyrillic finding."""
    items, top = {}, 0
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                op = e.get("op")
                if op == "meta":
                    top = max(top, int(e.get("max_id", 0)))
                elif op == "add":
                    # A compacted record carries its status; an old one does not.
                    items[e["id"]] = dict(e, status=e.get("status", "open"),
                                          status_ts=e.get("status_ts", e["ts"]))
                    top = max(top, e["id"])
                elif op == "set" and e.get("id") in items:
                    items[e["id"]]["status"] = e["status"]
                    items[e["id"]]["status_ts"] = e["ts"]
    except FileNotFoundError:
        pass
    return items, top


def load(project=None, archived=False):
    """{id: item} for one project, or every project when project is None."""
    items, _ = read(archive_path() if archived else ledger())
    if project is not None:
        items = {i: it for i, it in items.items() if it.get("project") == project}
    return items


class Locked:
    """Every writer holds this. The lock is a file of its own, not the ledger:
    compaction replaces the ledger, and a writer that had waited on the old
    file would append to a file that is no longer there."""

    def __enter__(self):
        os.makedirs(DIR, mode=0o700, exist_ok=True)
        self.f = open(os.path.join(DIR, "ledger.lock"), "a", encoding="utf-8")
        lock(self.f)
        return self

    def __exit__(self, *exc):
        self.f.close()


def append(project, events):
    with Locked():
        # Ids are assigned under the lock, from what is on disk now: two
        # sessions recording at once must not hand out the same number, and a
        # compacted or archived id is never handed out again.
        everything, top = read(ledger())
        next_id = max(max(everything, default=0), top) + 1
        items = {i: it for i, it in everything.items() if it.get("project") == project}
        out, lines = [], []
        for e in events:
            if e["op"] == "add":
                dup = duplicate(items, e)
                if dup:
                    out.append((dup, False))
                    continue
                e = dict(e, id=next_id, project=project)
                next_id += 1
                items[e["id"]] = dict(e, status="open")
                out.append((e["id"], True))
            lines.append(json.dumps(e, ensure_ascii=False) + "\n")
        if lines:
            with open(ledger(), "a", encoding="utf-8") as f:
                f.writelines(lines)
        if os.path.getsize(ledger()) > COMPACT_BYTES:
            compact_locked()
    return out


def stamp(ts):
    try:
        return datetime.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%S%z").timestamp()
    except (TypeError, ValueError):
        return time.time()          # unreadable: treat as recent, never archive


def compact_locked():
    """One record per finding at its current status; old `done` to the archive.

    Call with the lock held. The archive is written first: a crash between the
    two steps leaves a finding in both files, never in neither. The previous
    ledger is kept as ledger.jsonl.prev."""
    items, top = read(ledger())
    cutoff = time.time() - ARCHIVE_DAYS * 86400
    keep, old = [], []
    for it in sorted(items.values(), key=lambda it: it["id"]):
        rec = dict(it, op="add")
        (old if it["status"] == "done" and stamp(it["status_ts"]) < cutoff else keep).append(rec)
    if old:
        with open(archive_path(), "a", encoding="utf-8") as f:
            f.writelines(json.dumps(r, ensure_ascii=False) + "\n" for r in old)
    tmp = ledger() + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(json.dumps({"op": "meta", "max_id": max(top, max(items, default=0))}) + "\n")
        f.writelines(json.dumps(r, ensure_ascii=False) + "\n" for r in keep)
    if os.path.exists(ledger()):
        shutil.copy2(ledger(), ledger() + ".prev")
        shutil.copymode(ledger(), tmp)
    os.replace(tmp, ledger())
    return len(items), len(keep), len(old)


def norm(s):
    return " ".join(re.sub(r"[`*_]", "", s or "").lower().split())


def duplicate(items, e):
    where, text = norm(e.get("where")), norm(e.get("text"))
    for i, it in items.items():
        if it["status"] == "done":
            continue
        if where and norm(it.get("where")) != where:
            continue
        if difflib.SequenceMatcher(None, norm(it.get("text")), text).ratio() >= 0.6:
            return i
    return None


# ── parsing a reply ─────────────────────────────────────────────────────────

def parse_section(reply):
    """[(tags, where, text)] from the reply's found-along-the-way section."""
    m = None
    for m in SECTION.finditer(reply):
        pass
    if not m:
        return []
    body = reply[m.end():]
    nxt = HEADING.search(body)
    if nxt:
        body = body[:nxt.start()]
    out = []
    for line in body.splitlines():
        im = ITEM.match(line)
        if not im:
            continue
        rest = im.group(1)
        tags = []
        tm = TAGS.match(rest)
        if tm:
            for t in re.findall(r"\[([^\]]+)\]", tm.group(1)):
                t = TAG_MAP.get(t.strip().lower())
                if t:
                    tags.append(t)
            rest = rest[tm.end():]
        rest = OFFER.sub("", rest).strip()
        wm = re.match(r"`([^`]+)`", rest)
        where = wm.group(1) if wm else rest.split(" — ")[0].split(":")[0][:80]
        out.append((tags, where.strip(), rest))
    return out


def record(reply, cwd, session=None):
    # FINDINGS_RECORD=off is checked here, not in the callers: the Stop hook
    # and the Opencode plugin both end up in this function, so the switch
    # means the same thing in every assistant.
    if os.environ.get("FINDINGS_RECORD", "").lower() == "off":
        return []
    # One item at a time, in the order of the reply: ids then follow the chat
    # numbering, so "item 2" of a reply is the next id after "item 1".
    added = []
    for tags, where, text in parse_section(reply):
        p = route(where, cwd)
        [(i, new)] = append(p, [{"op": "add", "ts": now(), "session": session, "cwd": cwd,
                                 "tags": tags, "where": where, "text": text}])
        if new:
            added.append((p, i))
    return added


# ── output ──────────────────────────────────────────────────────────────────

def now():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def label(it):
    tags = "".join(f"[{t}]" for t in it.get("tags", []))
    return f"F{it['id']} {tags} {it['text']}".replace("  ", " ")


def current_session(explicit=None):
    return explicit or os.environ.get("FINDINGS_SESSION") or os.environ.get("CLAUDE_CODE_SESSION_ID") or None


def of_session(it, sid):
    return bool(sid) and (it.get("session") or "").startswith(sid)


def digest(project, statuses=("open", "park"), session=None, archived=False):
    items = [it for it in load(project, archived).values() if it["status"] in statuses
             and (session is None or of_session(it, session))]
    if not items:
        return ""
    order = {"open": 0, "park": 1, "skip": 2, "done": 3}
    items.sort(key=lambda it: (order[it["status"]], "urgent" not in it.get("tags", []), it["id"]))
    lines = [f"findings: {project}"]
    for it in items:
        mark = "" if it["status"] == "open" else f" ({it['status']})"
        lines.append(f"  {label(it)}{mark}  — {it['ts'][:10]}")
    return "\n".join(lines)


def counts(project):
    items = load(project).values()
    open_ = [it for it in items if it["status"] == "open"]
    urgent = [it for it in open_ if "urgent" in it.get("tags", [])]
    parked = sum(1 for it in items if it["status"] == "park")
    return open_, urgent, parked


def parse_ids(args):
    ids = []
    for a in args:
        for part in a.split(","):
            part = part.strip().lstrip("Ff#")
            if not part:
                continue
            if "-" in part:
                lo, hi = part.split("-", 1)
                ids += range(int(lo.lstrip("Ff#")), int(hi.lstrip("Ff#")) + 1)
            else:
                ids.append(int(part))
    return ids


def projects(archived=False):
    return sorted({it.get("project") for it in load(archived=archived).values() if it.get("project")})


def main(argv):
    ap = argparse.ArgumentParser(prog="findings", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd")
    for name in ("list", "count", "set", "add", "record", "compact"):
        s = sub.add_parser(name)
        s.add_argument("-p", "--project", default=None, help="a path inside the project (default: cwd)")
        if name == "list":
            s.add_argument("--all", action="store_true", help="same as --scope all")
            s.add_argument("--scope", choices=("session", "project", "all"), default=None,
                           help="default: session when its id is known, else project")
            s.add_argument("--session", default=None, help="session id or its prefix")
            s.add_argument("--status", default="open,park", help="comma list, or 'any'")
            s.add_argument("--archive", action="store_true",
                           help="the archive: done findings moved out by compaction")
        if name == "set":
            s.add_argument("status", choices=STATUSES)
            s.add_argument("ids", nargs="+")
        if name == "add":
            s.add_argument("--where", required=True)
            s.add_argument("--text", required=True)
            s.add_argument("--tag", action="append", default=[], choices=["related", "unrelated", "urgent"])
        if name in ("add", "record"):
            s.add_argument("--cwd", default=os.getcwd())
            s.add_argument("--session", default=None)
    # `findings park 4-9` reads like the chat answer it comes from.
    if argv and argv[0] in STATUSES:
        argv = ["set"] + argv
    a = ap.parse_args(argv)
    if not a.cmd:
        a = ap.parse_args(["list"] + argv)

    project = project_of(a.project or os.getcwd())

    if a.cmd == "list" and a.archive:
        targets = projects(archived=True) if (a.all or a.scope == "all") else [project]
        blocks = [b for b in (digest(p, STATUSES, archived=True) for p in targets) if b]
        print("\n\n".join(blocks) if blocks else "findings: archive is empty")
    elif a.cmd == "list":
        statuses = STATUSES if a.status == "any" else tuple(a.status.split(","))
        sid = current_session(a.session)
        scope = a.scope or ("all" if a.all else None)
        if scope is None:
            scope = "session" if sid else "project"
            if not sid:
                print("findings: no session id in this shell — showing the whole project "
                      "(--session ID narrows it)")
        if scope == "session" and not sid:
            print("findings: --scope session needs a session id (--session ID)", file=sys.stderr)
            return 2
        if scope == "session":
            # Everything this session found, whatever project it was filed under.
            blocks = [b for b in (digest(p, statuses, session=sid) for p in projects()) if b]
            print("\n\n".join(blocks) if blocks else f"findings: nothing from this session ({sid[:8]})")
            others = [it for it in load(project).values()
                      if it["status"] == "open" and not of_session(it, sid)]
            if others:
                print(f"\n+{len(others)} open in {project} from other sessions — /findings project")
        else:
            targets = projects() if scope == "all" else [project]
            blocks = [b for b in (digest(p, statuses) for p in targets) if b]
            print("\n\n".join(blocks) if blocks else "findings: nothing open")
    elif a.cmd == "count":
        open_, urgent, parked = counts(project)
        print(f"{len(open_)} open, {len(urgent)} urgent, {parked} parked — {project}")
    elif a.cmd == "set":
        items = load()
        ids = parse_ids(a.ids)
        missing = [i for i in ids if i not in items]
        if missing:
            archived = load(archived=True)
            gone = [i for i in missing if i in archived]
            if gone:
                print(f"findings: archived (done): {', '.join(f'F{i}' for i in gone)} — "
                      "`findings list --archive`; record the defect again if it is back",
                      file=sys.stderr)
            rest = [i for i in missing if i not in archived]
            if rest:
                print(f"findings: no such id: {', '.join(f'F{i}' for i in rest)}", file=sys.stderr)
            return 2
        append(None, [{"op": "set", "id": i, "ts": now(), "status": a.status} for i in ids])
        print(f"{a.status}: {', '.join(f'F{i}' for i in ids)}")
    elif a.cmd == "add":
        p = route(a.where, a.cwd) if not a.project else project
        tags = list(dict.fromkeys(a.tag))
        [(i, new)] = append(p, [{"op": "add", "ts": now(), "session": a.session, "cwd": a.cwd,
                                  "tags": tags, "where": a.where, "text": a.text}])
        print(f"{'added' if new else 'duplicate of'} F{i} — {p}")
    elif a.cmd == "compact":
        with Locked():
            before = os.path.getsize(ledger()) if os.path.exists(ledger()) else 0
            n, kept, archived = compact_locked()
            after = os.path.getsize(ledger())
        print(f"compacted: {n} findings — {kept} kept, {archived} archived; "
              f"{before // 1024} KiB -> {after // 1024} KiB")
    elif a.cmd == "record":
        for p, i in record(sys.stdin.read(), a.cwd, a.session):
            print(f"added F{i} — {p}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

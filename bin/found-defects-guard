#!/usr/bin/env python3
"""found-defects-guard — Stop hook that enforces rules/found-defects-last.md.

The rule: a defect noticed along the way is reported in a final section
("Найдено попутно" / "Found along the way"), never as a sentence in the body.
A rule in prose does not fire reliably, so this checks the finished reply.

Reads the Stop payload on stdin. Claude Code and Codex send the same fields:
  stop_hook_active        true when this turn already continued once
  last_assistant_message  the reply text
Answers:
  exit 0, no output                    reply passes
  exit 0 + {"decision":"block",...}    reply continues once; `reason` tells
                                       the model what to append
Never blocks twice in a row (stop_hook_active), and fails open on any error:
a broken guard must not trap a session.

Heuristic, by design: a phrase that defers a defect ("отдельная задача",
"also noticed", "out of scope") in the body, outside code, quotes and
blockquotes, means the defect was not put where the rule says. A false
positive costs one short continuation, and the model is told how to answer it.

FOUND_DEFECTS_GUARD=off disables the check; the ledger is still written
(FINDINGS_RECORD=off stops that). Each block is appended to
~/.local/state/found-defects-guard.log for tuning the patterns.
"""
import json
import os
import re
import sys
import time

SECTION = re.compile(
    r"^#{1,6}\s*(найдено\s+(попутно|по\s+ходу|по\s+пути|по\s+дороге|заодно)|попутно\s+найдено|попутные\s+находки|found\s+(along|on)\s+the\s+way)\s*:?\s*$",
    re.I | re.M)
HEADING = re.compile(r"^#{1,6}\s+\S", re.M)
ITEM = re.compile(r"^\s*\d+[.)]\s+\S", re.M)
# Proposals sit at the end and are read; "do it as a separate task" there is
# the proposed work itself, not a buried finding. The scan stops at them.
PROPOSALS = re.compile(r"^#{1,6}\s*(предлагаю|proposals)\s*:?\s*$", re.I | re.M)

DEFER = [
    # Russian
    # singular only: "отдельные вопросы" counts questions, it defers nothing
    r"отдельн(ая|ую|ой|ый|ым|ого)\s+(задач|вопрос|тикет|фикс)",
    r"(исправ|поправ|почин|чин)\w*\s+отдельно",
    # "нашёл и исправил" reports a fix, it defers nothing
    r"(ещё|еще|также|заодно|попутно|кстати|параллельно)[,]?\s+(я\s+)?"
    r"(нашёл|нашел|нашла|нашлось|заметил|заметила|обнаружил|обнаружила|увидел|увидела)"
    r"(?!\s+и\s+(сразу\s+)?(исправ|почин|поправ|устран))",
    r"не\s+связан\w*\s+с\s+(задач|текущ|основн)",
    r"(вне|за)\s+рамк\w+\s+(задач|текущ)",
    r"вне\s+(задачи|скоупа)",
    # English
    r"\bseparate\s+(task|issue|ticket|pr|fix|change)\b",
    # lower case only: "Out of scope" is also a ticket section name
    r"(?-i:\bout\s+of\s+scope\b)",
    r"\bunrelated\s+(to|bug|issue|problem)\b",
    r"\b(also|separately|incidentally|btw|by\s+the\s+way)[,]?\s+(i\s+)?(noticed|found|spotted)\b"
    r"(?!\s+and\s+(fixed|repaired|corrected))",
    r"\b(fix|address|handle)(ed|ing)?\s+(it\s+|that\s+|this\s+)?separately\b",
    r"\bpre-?existing\s+(bug|issue|problem)\b",
]
DEFER_RE = [re.compile(p, re.I) for p in DEFER]

LOG = os.environ.get("FOUND_DEFECTS_GUARD_LOG") or os.path.expanduser("~/.local/state/found-defects-guard.log")


def strip_quoted(text):
    """Drop what the reply quotes rather than says: code, blockquotes, quotes."""
    text = re.sub(r"```.*?```", " ", text, flags=re.S)
    text = re.sub(r"`[^`\n]*`", " ", text)
    text = re.sub(r"^\s*>.*$", " ", text, flags=re.M)
    text = re.sub(r"«[^»\n]*»", " ", text)
    text = re.sub(r"“[^”\n]*”", " ", text)
    text = re.sub(r"\"[^\"\n]{0,200}\"", " ", text)
    return text


def snippet(text, m):
    start = max(text.rfind("\n", 0, m.start()) + 1, m.start() - 60)
    end = text.find("\n", m.end())
    end = min(end if end != -1 else len(text), m.end() + 60)
    return " ".join(text[start:end].split())


def check(reply):
    """Return a list of problems; empty means the reply passes."""
    sections = list(SECTION.finditer(reply))
    problems = []
    if sections:
        last = sections[-1]
        if HEADING.search(reply, last.end()):
            problems.append("the found-defects section is not the last section of the reply")
        body = reply[:sections[0].start()]
    else:
        body = reply
    proposals = PROPOSALS.search(body)
    if proposals:
        body = body[:proposals.start()]
    clean = strip_quoted(body)
    seen = set()
    for rx in DEFER_RE:
        for m in rx.finditer(clean):
            s = snippet(clean, m)
            if s not in seen:
                seen.add(s)
                problems.append(f"deferred finding in the body: \"{s}\"")
    return problems


def section_items(reply):
    """Number of items in the reply's last found-defects section, 0 if none."""
    sections = list(SECTION.finditer(reply))
    if not sections:
        return 0
    body = reply[sections[-1].end():]
    nxt = HEADING.search(body)
    if nxt:
        body = body[:nxt.start()]
    return len(ITEM.findall(body))


def reason(problems, have=0):
    # Claude Code shows this text to the user as "Stop hook error", so it is
    # kept to the problem and one instruction. The format of the section is in
    # the rule file, which the model already has in context.
    lines = "\n".join(f"- {p}" for p in problems)
    # The continuation is a new message: it cannot merge into the section the
    # reply already printed. Numbering on from it makes the two read as one
    # list, and keeps "fix 2" unambiguous. The heading stays: the ledger finds
    # the items by it.
    if have:
        shown = f"items 1-{have} are" if have > 1 else "item 1 is"
        scope = f", numbered from {have + 1} ({shown} already shown)"
    else:
        scope = ""
    return (
        f"found-defects-guard:\n{lines}\n"
        f"Output only the found-defects section per rules/found-defects-last.md{scope}, "
        "new defects only. Not a defect: output (found-defects-guard: false positive)"
    )


def log(problems, payload):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(json.dumps({
                "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                "session_id": payload.get("session_id"),
                "cwd": payload.get("cwd"),
                "problems": problems,
            }, ensure_ascii=False) + "\n")
    except OSError:
        pass


def turn_texts(payload, reply):
    """Every assistant text of the turn that just ended, oldest first.

    The Stop payload carries only the last text block. A section written
    mid-turn — before an AskUserQuestion, before more tool calls — is not in
    it, and was never recorded (F87, 2026-10-04). Claude Code's transcript has
    the whole turn: the texts after the last real user prompt. Any other
    shape (Codex rollout, no transcript) falls back to the last text alone."""
    texts = []
    path = payload.get("transcript_path")
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if e.get("isSidechain"):
                    continue
                msg = e.get("message") or {}
                c = msg.get("content")
                if e.get("type") == "user" and not e.get("isMeta"):
                    if isinstance(c, str) or (isinstance(c, list) and any(
                            isinstance(b, dict) and b.get("type") == "text" for b in c)):
                        texts = []
                elif e.get("type") == "assistant" and isinstance(c, list):
                    texts += [b["text"] for b in c
                              if isinstance(b, dict) and b.get("type") == "text" and b.get("text")]
    except (OSError, TypeError):
        texts = []
    # The last block may not be in the file yet when the hook runs.
    if reply.strip() not in (t.strip() for t in texts):
        texts.append(reply)
    return texts


def ledger_record(reply, payload):
    """Write the reply's found-along-the-way items to bin/findings' ledger.

    Runs on every stop, the continuation included: that is the reply the
    section was added to. Best-effort — a ledger failure never blocks.
    FINDINGS_RECORD=off is honoured inside findings.record_items().

    Returns the notice to show the user — chat number, id and path of each
    item — when the reply did not carry the ids itself; "" otherwise."""
    try:
        sys.dont_write_bytecode = True
        import importlib.util
        from importlib.machinery import SourceFileLoader
        here = os.path.dirname(os.path.realpath(__file__))
        loader = SourceFileLoader("findings", os.path.join(here, "findings"))
        spec = importlib.util.spec_from_loader("findings", loader)
        findings = importlib.util.module_from_spec(spec)
        loader.exec_module(findings)
        items = findings.record_items(reply, payload.get("cwd") or os.getcwd(),
                                      payload.get("session_id"))
        return findings.recorded_notice(items), [r["id"] for r in items]
    except Exception:
        return "", []


HELP = {
    "ru": ("Решить одной строкой: /findings fix|park|skip|done|open {ids}",
           "fix — исправить · park — отложить · skip — отклонить · done — уже исправлено · open — вернуть"),
    "en": ("Decide in one line: /findings fix|park|skip|done|open {ids}",
           "fix — fix now · park — defer · skip — decline · done — already fixed · open — reopen"),
}


def help_notice(reply, ids):
    """The ready answer and the mini-help, when the reply's section lacks them.

    The rule asks for both under every section; a model forgets. Detected by
    the verbs: a section that names neither `park` nor `skip` has no help.
    The ids are those the hook just recorded, else the F numbers the section
    lists (a digest). Russian when the section heading is."""
    sections = list(SECTION.finditer(reply))
    if not sections:
        return ""
    last = sections[-1]
    body = reply[last.end():]
    nxt = HEADING.search(body)
    if nxt:
        body = body[:nxt.start()]
    if re.search(r"\bpark\b", body) and re.search(r"\bskip\b", body):
        return ""
    if not ids:
        ids = [int(i) for i in re.findall(r"^\s*(?:\d+[.)]\s+)?F(\d+)\b", body, re.M)]
    if not ids:
        return ""
    ids = sorted(dict.fromkeys(ids))
    lang = "ru" if re.search(r"[а-яё]", last.group(1), re.I) else "en"
    answer, verbs = HELP[lang]
    return answer.format(ids=",".join(f"F{i}" for i in ids)) + "\n" + verbs


def main():
    payload = json.load(sys.stdin)
    reply = payload.get("last_assistant_message") or ""
    if not reply.strip():
        return
    # Recording comes first: FOUND_DEFECTS_GUARD=off turns off the check, not
    # the ledger. FINDINGS_RECORD=off is the switch for that.
    # The notice (which F number each item got) is shown even with the check
    # off: it is part of recording, not of the check.
    out = {}
    parts = []
    for text in turn_texts(payload, reply):
        if not SECTION.search(text):
            continue
        notice, ids = ledger_record(text, payload)
        for p in (notice, help_notice(text, ids)):
            if p and p not in parts:
                parts.append(p)
    if parts:
        out["systemMessage"] = "\n".join(parts)
    if (os.environ.get("FOUND_DEFECTS_GUARD", "").lower() != "off"
            and not payload.get("stop_hook_active")):
        problems = check(reply)
        if problems:
            log(problems, payload)
            out.update(decision="block", reason=reason(problems, section_items(reply)))
    if out:
        sys.stdout.write(json.dumps(out, ensure_ascii=False))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
